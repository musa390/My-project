# Backend REST API origin (must match backend CORS allowlist).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional: set the canonical public URL before deployment to enable absolute metadata and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Contact form: keep demo until the email provider and verified business inbox are ready.
NEXT_PUBLIC_CONTACT_FORM_MODE=demo
CONTACT_FORM_MODE=demo
# For real email mode, set both modes to email and add the following server-only values:
# RESEND_API_KEY=re_xxxxxxxxx
# CONTACT_TO_EMAIL=support@your-domain.com
# CONTACT_FROM_EMAIL=LUXE PERFUME <contact@your-domain.com>
