# Copy this file to .env for local development and replace placeholders.
# Never commit .env or real credentials.

# MySQL (local Docker Compose)
MYSQL_DATABASE=luxe_perfume
MYSQL_USER=luxe_app
MYSQL_PASSWORD=replace_with_a_local_dev_password
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password
MYSQL_PORT=3306

# Backend (Spring Boot service)
BACKEND_PORT=8080

# Customer frontend public site metadata (create customer-frontend/.env.local separately)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API client expects the backend origin only; it appends /api/v1/... itself.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Authentication (development placeholder only; generate a unique production key)
JWT_SECRET_BASE64=replace_with_base64_encoded_random_32_byte_or_longer_key
JWT_ISSUER=luxe-perfume-api
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_EMAIL_FROM=your_verified_sender@example.com
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/reset-password
AUTH_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/account
STOREFRONT_URL=http://localhost:3000
CONTACT_ADMIN_EMAIL=
SPRING_PROFILES_ACTIVE=

# Future integrations — keep empty until configured by the project owner
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
